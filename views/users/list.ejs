<%- include('../partials/header') %>

<div class="panel">
  <div class="section-title">إضافة مستخدم جديد</div>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="POST" action="/users">
    <div class="grid">
      <div class="field"><label>الاسم الكامل</label><input name="full_name" required></div>
      <div class="field"><label>اسم المستخدم</label><input name="username" required></div>
      <div class="field"><label>كلمة المرور</label><input name="password" type="password" required></div>
      <div class="field">
        <label>الصلاحية</label>
        <select name="role">
          <option value="sales">موظف مبيعات</option>
          <option value="admin">مدير</option>
        </select>
      </div>
    </div>
    <div class="actions"><button class="btn-primary" type="submit">إنشاء المستخدم</button></div>
  </form>

  <div class="section-title" style="margin-top:26px;">المستخدمون الحاليون</div>
  <table class="data">
    <thead><tr><th>الاسم</th><th>اسم المستخدم</th><th>الصلاحية</th><th>الحالة</th><th>إجراء</th></tr></thead>
    <tbody>
      <% users.forEach(u => { %>
        <tr>
          <td><%= u.full_name %></td>
          <td><%= u.username %></td>
          <td><%= u.role === 'admin' ? 'مدير' : 'موظف مبيعات' %></td>
          <td><span class="badge <%= u.active ? 'badge-approved' : 'badge-rejected' %>"><%= u.active ? 'مفعّل' : 'موقوف' %></span></td>
          <td>
            <form method="POST" action="/users/<%= u.id %>/toggle-active" style="display:inline">
              <button class="btn-ghost btn-sm" type="submit"><%= u.active ? 'إيقاف' : 'تفعيل' %></button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
