# رابط قاعدة البيانات (Railway هيولّده تلقائيًا لما تضيف Postgres Plugin)
DATABASE_URL=postgresql://user:password@localhost:5432/car_sale_system

# اكتب false لو شغال محليًا على قاعدة بيانات من غير SSL
DATABASE_SSL=true

# مفتاح تشفير الجلسات - غيّره لأي نص عشوائي طويل
SESSION_SECRET=change-this-to-a-long-random-string

# التوكن المطلوب لإنشاء أول حساب مدير عبر صفحة /setup (استخدمه مرة واحدة بس)
SETUP_TOKEN=change-this-to-a-secret-token

PORT=3000
