# رابط قاعدة البيانات PostgreSQL (يوفره Railway/Render تلقائياً عند إضافة قاعدة بيانات)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# سرّ توقيع تسجيل الدخول (JWT) - غيّره لأي نص عشوائي طويل قبل النشر
JWT_SECRET=change-this-to-a-long-random-secret-before-deploying

# اسم مستخدم وكلمة مرور أول حساب مدير يُنشأ تلقائياً عند تشغيل seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=مدير النظام

PORT=3000
